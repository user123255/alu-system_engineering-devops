#!/usr/bin/env bash
# Install nginx if not installed
apt-get update -y
apt-get install -y nginx

# Create the HTML root and page
mkdir -p /usr/share/nginx/html
echo "Hello Holberton" > /usr/share/nginx/html/index.html

# Remove stale PID
rm -f /run/nginx.pid

# Start Nginx
nginx

# Wait until port 80 is open
while ! nc -z 127.0.0.1 80; do
    sleep 1
done
