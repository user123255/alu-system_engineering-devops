#!/usr/bin/env bash
# 0-nginx_likes_port_80

# Stop any process (like haproxy) that might be using port 80
sudo systemctl stop haproxy 2>/dev/null
sudo pkill -f nginx 2>/dev/null

# Remove nginx PID file if it exists
sudo rm -f /run/nginx.pid

# Update main nginx.conf to listen on port 80 instead of 8080
sudo sed -i 's/listen \[::\]:8080;/listen [::]:80;/' /etc/nginx/nginx.conf

# Reload or start nginx
sudo nginx -t  # Test configuration
sudo systemctl restart nginx 2>/dev/null || sudo nginx
