#!/bin/bash
# 1-run_nginx_as_nginx

set -e

# Install nginx if missing
if ! command -v nginx >/dev/null 2>&1; then
    apt-get update -y
    apt-get install -y nginx
fi

# Ensure nginx user exists
id -u nginx >/dev/null 2>&1 || useradd -r -s /bin/false nginx

# Give nginx ownership of web and log directories
chown -R nginx:nginx /var/www/html /var/log/nginx || true

# Configure nginx.conf to run as nginx user
if ! grep -q '^user nginx;' /etc/nginx/nginx.conf; then
    sed -i 's/^user .*/user nginx;/' /etc/nginx/nginx.conf
fi

# Update default site to listen on 8080
sed -i 's/listen 80 default_server;/listen 8080 default_server;/' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/' /etc/nginx/sites-available/default

# Remove old PID file
rm -f /run/nginx.pid

# Kill any old Nginx processes
pkill -f nginx || true

# Start Nginx as nginx user
sudo -u nginx nginx -g "daemon off;"
