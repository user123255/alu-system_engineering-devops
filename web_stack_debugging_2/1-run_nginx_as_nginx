#!/bin/bash
# Configure Nginx to run as nginx user and listen on port 8080

# Ensure nginx user exists
id nginx || sudo useradd -r nginx

# Set nginx user
sudo sed -i 's/^user .*/user nginx;/' /etc/nginx/nginx.conf

# Change port
sudo sed -i 's/listen 80 default_server;/listen 8080 default_server;/' /etc/nginx/sites-available/default
sudo sed -i 's/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/' /etc/nginx/sites-available/default

# Fix permissions
sudo chown -R nginx:nginx /var/log/nginx
sudo chown -R nginx:nginx /var/lib/nginx
sudo chown -R nginx:nginx /var/www/html

# Stop nginx
sudo pkill nginx || true

# Start nginx as nginx user
sudo -u nginx nginx
