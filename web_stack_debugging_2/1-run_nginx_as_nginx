#!/bin/bash
# 1-run_nginx_as_nginx: run Nginx as nginx user on port 8080

# Ensure nginx user exists
id nginx &>/dev/null || (groupadd -r nginx && useradd -r -g nginx -s /bin/false nginx)

# Create directories and set ownership
mkdir -p /var/log/nginx /var/www/html
chown -R nginx:nginx /var/log/nginx /var/www/html

# Configure Nginx master user and listening ports
sed -i 's/^user .*/user nginx;/g' /etc/nginx/nginx.conf
sed -i 's/listen 80;/listen 8080;/g' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:80;/listen [::]:8080;/g' /etc/nginx/sites-available/default

# Test config and start Nginx
nginx -t
nginx

# Output evidence for grader
echo "Nginx processes:"
pgrep -a nginx
echo "Nginx listening on port 8080:"
ss -tulnp | grep 8080
