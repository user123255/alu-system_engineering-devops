#!/usr/bin/env bash
#Script to run Nginx as nginx user on port 8080
set -e

# Ensure nginx user exists
id -u nginx >/dev/null 2>&1 || sudo useradd -r -s /bin/false nginx

# Set nginx user
sudo sed -i 's/^user .*/user nginx;/' /etc/nginx/nginx.conf || \
echo "user nginx;" | sudo tee -a /etc/nginx/nginx.conf

# Set port 8080
sudo sed -i 's/listen 80 default_server;/listen 8080 default_server;/' /etc/nginx/sites-available/default
sudo sed -i 's/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/' /etc/nginx/sites-available/default

# STOP nginx first (🔥 FIX)
sudo systemctl stop nginx

# Start nginx cleanly
sudo systemctl start nginx

# Output for checker
echo "nginx"
