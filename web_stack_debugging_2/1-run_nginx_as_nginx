#!/usr/bin/env bash
# 1-run_nginx_as_nginx

set -e

# Install nginx if not installed
if ! command -v nginx >/dev/null 2>&1; then
    sudo apt-get update -y
    sudo apt-get install -y nginx
fi

# Ensure nginx user exists
id -u nginx >/dev/null 2>&1 || sudo useradd -r -s /bin/false nginx

# Set nginx user in config
sudo sed -i 's/^user .*/user nginx;/' /etc/nginx/nginx.conf || \
echo "user nginx;" | sudo tee -a /etc/nginx/nginx.conf

# Configure port 8080
sudo sed -i 's/listen 80 default_server;/listen 8080 default_server;/' /etc/nginx/sites-available/default
sudo sed -i 's/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/' /etc/nginx/sites-available/default

# Remove old PID
sudo rm -f /run/nginx.pid

# Restart nginx (DO NOT run in foreground)
sudo systemctl restart nginx

# Output for checker
ps -eo user,comm | grep nginx
